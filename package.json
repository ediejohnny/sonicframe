{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sonicframe",
    "version": "0.1.0",
    "description": "Audio visualization and interaction framework for the web.",
    "keywords": [
        "audio",
        "canvas",
        "markers",
        "player",
        "visualization",
        "waveform"
    ],
    "license": "MIT",
    "author": "Edie Johnny",
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./analysis": {
            "types": "./dist/analysis.d.ts",
            "default": "./dist/analysis.js"
        },
        "./player": {
            "types": "./dist/player.d.ts",
            "default": "./dist/player.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp dev",
        "test": "vp test run",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "prepublishOnly": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1 && vp pack"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "happy-dom": "^21.0.4",
        "typescript": "^7.0.2",
        "vite-plus": "1.1.0"
    }
}
