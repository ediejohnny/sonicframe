{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sonicframe",
    "version": "1.3.0",
    "description": "Audio visualization and interaction framework for the web.",
    "keywords": [
        "audio",
        "canvas",
        "markers",
        "player",
        "visualization",
        "waveform"
    ],
    "homepage": "https://ediejohnny.github.io/sonicframe/",
    "bugs": {
        "url": "https://github.com/ediejohnny/sonicframe/issues"
    },
    "license": "MIT",
    "author": "Edie Johnny",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ediejohnny/sonicframe.git"
    },
    "funding": {
        "type": "individual",
        "url": "https://buymeacoffee.com/ediejohnny"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./analysis": {
            "types": "./dist/analysis.d.ts",
            "default": "./dist/analysis.js"
        },
        "./player": {
            "types": "./dist/player.d.ts",
            "default": "./dist/player.js"
        },
        "./record": {
            "types": "./dist/record.d.ts",
            "default": "./dist/record.js"
        },
        "./playlist": {
            "types": "./dist/playlist.d.ts",
            "default": "./dist/playlist.js"
        },
        "./min": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.min.js"
        },
        "./min/analysis": {
            "types": "./dist/analysis.d.ts",
            "default": "./dist/analysis.min.js"
        },
        "./min/player": {
            "types": "./dist/player.d.ts",
            "default": "./dist/player.min.js"
        },
        "./min/record": {
            "types": "./dist/record.d.ts",
            "default": "./dist/record.min.js"
        },
        "./min/playlist": {
            "types": "./dist/playlist.d.ts",
            "default": "./dist/playlist.min.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp dev",
        "docs:build": "vp build --config vite.docs.config.ts",
        "test": "vp test run",
        "lint": "vp check",
        "lint:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "prepublishOnly": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1 && vp pack"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "fast-check": "4.10.2",
        "happy-dom": "^21.0.4",
        "jscpd": "5.4.2",
        "prismjs": "1.30.0",
        "typescript": "^7.0.2",
        "vite-plus": "1.4.0"
    }
}
